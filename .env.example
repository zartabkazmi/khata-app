# Copy this file to .env and fill in your own values.
# Both are FREE -- see README.md "Setup" section for exact steps.

# OAuth Client ID from Google Cloud Console (APIs & Services > Credentials)
# Leave blank for now -- the app works fine in local-only mode (data stays
# on the device) until you add this. See README Part 2 to set it up later.
VITE_GOOGLE_CLIENT_ID=

# Signing in with this exact email unlocks the Admin panel in Settings.
VITE_ADMIN_EMAIL=askthebhai@gmail.com
